{
    "name": "starlight-fsharp-literate",
    "version": "1.1.1",
    "description": "F# Literate (.fsx) file support for Astro Starlight",
    "type": "module",
    "packageManager": "pnpm@11.17.0",
    "repository": {
        "url": "https://github.com/MangelMaxime/starlight-fsharp-literate"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "prepare": "node --eval \"if (process.env.CI || process.env.ACT) { console.log('Skipping husky install in CI/ACT environment'); process.exit(0); } require('child_process').execSync('dotnet husky install', {stdio: 'inherit'})\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@astrojs/markdown-remark": "^7.0.0",
        "astro": "^7.0.0"
    },
    "devDependencies": {
        "@hideoo/tsconfig": "^2.0.3",
        "@types/node": "^26.1.1",
        "astro": "^7.1.3",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "approve-builds": "^1.0.0"
    }
}
